<Window x:Class="_3practsheynemanv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3practsheynemanv"
        mc:Ignorable="d"
        Title="Руль" Height="710" Width="1000" MinHeight="710" MinWidth="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Grid Grid.Row="0" Background="#FF76E383">
            <Button x:Name="btnBack" Content="Назад" HorizontalAlignment="Right" 
                    Cursor="Hand" Click="btnBack_Click" Width="120" Height="40" Margin="0,0,10,0"/>
            <Image HorizontalAlignment="Left" Margin="10,7,0,7" Width="45" Source="/Images/logo.jpg"/>
        </Grid>

        <!-- Фрейм для страниц -->
        <Frame x:Name="FrmMain" Grid.Row="1" NavigationUIVisibility="Hidden" 
               ContentRendered="FrmMain_ContentRendered"/>
    </Grid>
</Window>